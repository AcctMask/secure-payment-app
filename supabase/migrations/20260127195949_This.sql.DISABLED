CREATE OR REPLACE TRIGGER "trg_issuing_events_fill_member_id" BEFORE INSERT OR UPDATE OF "email" ON "public"."issuing_events" FOR EACH ROW EXECUTE FUNCTION "public"."pashloc_fill_member_id_nullable"();



