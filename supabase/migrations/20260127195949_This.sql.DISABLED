CREATE EXTENSION IF NOT EXISTS "wrappers" WITH SCHEMA "extensions";






CREATE OR REPLACE FUNCTION "public"."pashloc_fill_member_id_from_email"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    AS $$
begin
  new.member_id := public.pashloc_get_or_create_member_id(new.email);
  return new;
end;
$$;


ALTER FUNCTION "public"."pashloc_fill_member_id_from_email"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."pashloc_fill_member_id_nullable"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    AS $$
begin
  if new.email is not null and length(trim(new.email)) > 0 then
    new.member_id := public.pashloc_get_or_create_member_id(new.email);
  end if;
  return new;
end;
$$;


ALTER FUNCTION "public"."pashloc_fill_member_id_nullable"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."pashloc_get_or_create_member_id"("p_email" "text") RETURNS "uuid"
    LANGUAGE "plpgsql"
    AS $$
declare
  mid uuid;
begin
  if p_email is null or length(trim(p_email)) = 0 then
    raise exception 'email is required';
  end if;

  select id into mid
  from public.members
  where email = p_email;

  if mid is null then
    insert into public.members (email, membership_status, member_since)
    values (p_email, 'active', now())
    returning id into mid;
  end if;

  return mid;
end;
$$;


ALTER FUNCTION "public"."pashloc_get_or_create_member_id"("p_email" "text") OWNER TO "postgres";

SET default_tablespace = '';

SET default_table_access_method = "heap";


CREATE TABLE IF NOT EXISTS "public"."funding_cards" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "member_id" "uuid" NOT NULL,
    "email" "text" NOT NULL,
    "stripe_payment_method_id" "text" NOT NULL,
    "brand" "text",
    "last4" "text",
    "exp_month" integer,
    "exp_year" integer,
    "is_default" boolean DEFAULT true,
    "created_at" timestamp with time zone DEFAULT "now"()
);


ALTER TABLE "public"."funding_cards" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."funding_sources" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "member_id" "uuid" NOT NULL,
    "stripe_payment_method_id" "text",
    "brand" "text",
    "last4" "text",
    "exp_month" smallint,
    "exp_year" smallint,
    "is_default" boolean DEFAULT false NOT NULL,
    "created_at" timestamp with time zone DEFAULT "now"() NOT NULL,
    "updated_at" timestamp with time zone DEFAULT "now"() NOT NULL
);


ALTER TABLE "public"."funding_sources" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."issuing_cardholders" (
    "member_id" "uuid" NOT NULL,
    "email" "text" NOT NULL,
    "stripe_cardholder_id" "text" NOT NULL,
    "created_at" timestamp with time zone DEFAULT "now"()
);


ALTER TABLE "public"."issuing_cardholders" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."issuing_cards" (
    "stripe_card_id" "text" NOT NULL,
    "member_id" "uuid" NOT NULL,
    "email" "text" NOT NULL,
    "last4" "text",
    "exp_month" integer,
    "exp_year" integer,
    "brand" "text",
    "status" "text",
    "created_at" timestamp with time zone DEFAULT "now"()
);


ALTER TABLE "public"."issuing_cards" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."issuing_events" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "member_id" "uuid",
    "email" "text",
    "event_type" "text" NOT NULL,
    "stripe_authorization_id" "text",
    "stripe_transaction_id" "text",
    "stripe_charge_id" "text",
    "amount" bigint,
    "currency" "text",
    "merchant_name" "text",
    "status" "text",
    "raw" "jsonb",
    "created_at" timestamp with time zone DEFAULT "now"()
);


ALTER TABLE "public"."issuing_events" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."members" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "user_id" "text" NOT NULL,
    "stripe_customer_id" "text",
    "stripe_cardholder_id" "text",
    "membership_status" "text" DEFAULT 'pending'::"text",
    "created_at" timestamp with time zone DEFAULT "now"(),
    "updated_at" timestamp with time zone DEFAULT "now"(),
    "email" "text",
    CONSTRAINT "members_membership_status_check" CHECK (("membership_status" = ANY (ARRAY['pending'::"text", 'active'::"text", 'canceled'::"text"])))
);


ALTER TABLE "public"."members" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."transactions" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "member_id" "uuid" NOT NULL,
    "stripe_card_id" "text" NOT NULL,
    "stripe_transaction_id" "text" NOT NULL,
    "amount" bigint,
    "currency" "text",
    "merchant_name" "text",
    "created_at" timestamp with time zone DEFAULT "now"()
);


ALTER TABLE "public"."transactions" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."virtual_cards" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "member_id" "uuid" NOT NULL,
    "stripe_card_id" "text" NOT NULL,
    "last4" "text",
    "exp_month" integer,
    "exp_year" integer,
    "status" "text" DEFAULT 'active'::"text" NOT NULL,
    "created_at" timestamp with time zone DEFAULT "now"(),
    "updated_at" timestamp with time zone DEFAULT "now"(),
    CONSTRAINT "virtual_cards_status_check" CHECK (("status" = ANY (ARRAY['active'::"text", 'used'::"text", 'inactive'::"text"])))
);


ALTER TABLE "public"."virtual_cards" OWNER TO "postgres";


